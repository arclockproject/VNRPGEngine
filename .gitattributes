# Big binary art and sound: stored with Git LFS (run `pnpm setup:lfs` once per clone).
# Git history then holds small pointers, so cloning stays fast however much art the game gets.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
