{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["(", ")"], ["'", "'"], ["\"", "\""]],
  "wordPattern": "[a-zA-Z0-9_/#.]+",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(choice:|if .*:|elif .*:|else:|\\* .*)\\s*$",
    "decreaseIndentPattern": "^\\s*(elif .*:|else:)\\s*$"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*(choice:|if .*:|elif .*:|else:)\\s*$", "action": { "indent": "indent" } },
    { "beforeText": "^\\s*\\* .*$", "action": { "indent": "indent" } }
  ]
}
