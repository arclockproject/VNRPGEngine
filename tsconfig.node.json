{
  // Node-side code: vite config, electron main/preload, build scripts.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vscode"],
    // src/content/config/app.ts is read by the build scripts too (its type import uses @/).
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "electron", "scripts", "vite", "tools"]
}
